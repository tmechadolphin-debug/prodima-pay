# Render / PTY Drive backend
NODE_ENV=production

# Render asigna PORT automáticamente. Puedes dejarlo sin configurar.
# PORT=10000

# Supabase PostgreSQL connection string.
# Usa el connection string de Supabase, idealmente pooler + ssl.
DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Debe ser una clave nueva, larga y privada. No uses la que compartiste antes.
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_DE_64_CARACTERES

# Para empezar puedes usar *, luego restringimos:
# https://tu-admin-web.onrender.com,exp://localhost:8081
CORS_ORIGIN=*

# Admin inicial que se crea automáticamente al primer arranque.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=Cambia_Esta_Clave_Admin_2026
ADMIN_NAME=Administrador

# Reglas del negocio
RIDE_EXPIRE_MINUTES=10
SOS_COOLDOWN_MINUTES=5
